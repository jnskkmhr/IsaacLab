# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp
wandb

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Tests
tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*

# Robot asset and texture files (these are large files that should not be tracked in git)
!source/isaaclab_assets/data/*/*.usd
!source/isaaclab_assets/data/*/*/*.usd
!source/isaaclab_assets/data/*/*/*/*.usd
!source/isaaclab_assets/data/texture/**/*.png
!source/isaaclab_assets/data/texture/**/*.jpg
!source/isaaclab_assets/data/*/*/*/*/*/*.png
!source/isaaclab_assets/data/policies/**/*.pt
!source/isaaclab_assets/data/policies/**/*.onnx